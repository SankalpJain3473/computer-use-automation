# Copy this file to .env and fill in your own key. .env is gitignored and is
# never committed - see .gitignore.

# Required only for `npm run discover` and `npm run agent-demo` (the two
# things that call an LLM). Replay, stability, the server and tests don't.
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the model. Must support OpenAI-style tool calling.
# Default: cohere/north-mini-code:free (see src/llm/model.ts). OpenRouter's
# free tier changes over time; if the default 404s, pick a current one from
# https://openrouter.ai/models?max_price=0 that lists "tools".
# OPENROUTER_MODEL=cohere/north-mini-code:free

# Optional overrides, all have sane defaults:
# TARGET_APP_PORT=4173
# TARGET_APP_URL=http://localhost:4173
# OPERATOR_PORT=4174
# SERVER_PORT=4180
# HEADLESS=true
