{
  "name": "Computer-Use Automation",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "postCreateCommand": "npm ci && npx playwright install --with-deps chromium",
  "postAttachCommand": "sh .devcontainer/start.sh",
  "forwardPorts": [4180, 4173, 4174],
  "portsAttributes": {
    "4180": { "label": "Control center", "onAutoForward": "openBrowser" },
    "4173": { "label": "Bank app", "onAutoForward": "notify" },
    "4174": { "label": "Operator console (CLI runs)", "onAutoForward": "silent" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
